{
  "name": "swiftcipher",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "eslint . --max-warnings 0",
    "type-check": "tsc --noEmit",
    "test": "node --test \"supabase/tests/*.test.mjs\" \"tests/*.test.mjs\"",
    "test:db": "node --test \"supabase/tests/*.test.mjs\"",
    "build:sql": "node scripts/build-setup-sql.mjs && node scripts/build-update-sql.mjs",
    "build:e2e": "cross-env-shell NEXT_DIST_DIR=.next-prod next build",
    "start:e2e": "cross-env-shell NEXT_DIST_DIR=.next-prod next start -p 3100",
    "test:e2e": "playwright test",
    "keep-alive": "node scripts/keep-alive.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.45.4",
    "clsx": "^2.1.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.453.0",
    "mammoth": "^1.12.1",
    "next": "^16.3.6",
    "pdf-parse": "^2.4.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^2.5.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.63.0",
    "@types/node": "^20.16.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.20",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.6",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2"
  }
}
