# =============================================================================
# SwiftCipher environment. Copy to .env.local and fill in. NEVER commit .env.local.
# =============================================================================

# --- Supabase (Project Settings → API) ---------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Public "anon" key: every browser query runs under row-level security.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used for: auth account deletion, email invites, storing reports,
# billing webhooks, and scripts/smoke.mjs. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Only needed for `supabase db push` / scripts (Project Settings → Database).
SUPABASE_DB_PASSWORD=

# --- App ---------------------------------------------------------------------
# Public URL of this deployment. Used for auth redirects, device-agent policy
# (the app itself is always an allowed site), and email links.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Comma-separated OAuth providers enabled in Supabase Auth, e.g. google,azure
NEXT_PUBLIC_SSO_PROVIDERS=

# --- WebRTC (optional TURN for strict school networks) -------------------------
NEXT_PUBLIC_TURN_URL=
NEXT_PUBLIC_TURN_USERNAME=
NEXT_PUBLIC_TURN_CREDENTIAL=

# --- Billing (optional; without these, plans are changed manually) -----------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_TEACHER_PRO=
STRIPE_PRICE_SCHOOL=
STRIPE_PRICE_SCHOOL_PLUS=

# --- Company details shown in Terms / Privacy / DPA (required for production) ---
NEXT_PUBLIC_LEGAL_ENTITY=
NEXT_PUBLIC_LEGAL_ADDRESS=
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_PRIVACY_EMAIL=
# e.g. "EU (Frankfurt, eu-central-1)" — the region of your Supabase project
NEXT_PUBLIC_HOSTING_REGION=
# Optional: defaults to "the Federal Republic of Nigeria"
NEXT_PUBLIC_GOVERNING_LAW=
